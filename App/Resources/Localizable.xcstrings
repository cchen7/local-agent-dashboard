      }
    },
    "To finish enabling launch at login, approve Agent Dashboard in System Settings → General → Login Items & Extensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To finish enabling launch at login, approve Agent Dashboard in System Settings → General → Login Items & Extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「系统设置 → 通用 → 登录项与扩展」批准 Agent Dashboard，以启用登录时启动。"
          }
        }
      }
    },
